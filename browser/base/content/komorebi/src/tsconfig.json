{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "strict": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["**/*.ts"]
}
